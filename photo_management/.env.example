# Django Photo Management - Environment Variables Configuration
# Copy this file to .env and update the values for your environment

# =============================================================================
# SECURITY SETTINGS
# =============================================================================

# Django Secret Key
# CRITICAL: Generate a new secret key for production
# You can generate one using: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=your-secret-key-here-change-this-in-production

# Debug Mode
# IMPORTANT: Set to False in production for security
# Only set to True in development
DJANGO_DEBUG=True

# Allowed Hosts
# Comma-separated list of domains allowed to serve the application
# Example: example.com,www.example.com
# For development: localhost,127.0.0.1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# DATABASE SETTINGS (Optional - currently using SQLite)
# =============================================================================

# Uncomment and configure if using PostgreSQL in production
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=photo_management
# DB_USER=your_db_user
# DB_PASSWORD=your_db_password
# DB_HOST=localhost
# DB_PORT=5432

# =============================================================================
# CACHE SETTINGS (Optional)
# =============================================================================

# For production, use Redis for caching (rate limiting, sessions)
# REDIS_URL=redis://localhost:6379/1

# =============================================================================
# EMAIL SETTINGS (Optional - for password reset, notifications)
# =============================================================================

# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-email-password

# =============================================================================
# STATIC FILES & MEDIA (Production)
# =============================================================================

# STATIC_ROOT=/var/www/photo_management/static
# MEDIA_ROOT=/var/www/photo_management/media

# =============================================================================
# NOTES
# =============================================================================

# 1. Never commit the actual .env file to version control
# 2. Keep .env in your .gitignore file
# 3. Each environment (dev, staging, production) should have its own .env
# 4. Always use strong, unique secret keys in production
# 5. Set DJANGO_DEBUG=False in production
